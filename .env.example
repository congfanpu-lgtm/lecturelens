# 复制为 .env 后按需修改。不填 key 也能跑:默认 mock(固定剧本、不花钱)。
LLM_PROVIDER=mock
LLM_MODEL=mock-small
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_PRICE_PER1K=0.001
# 真实模型示例(任一 OpenAI 兼容服务),以 DeepSeek 为例:
#   LLM_PROVIDER=openai
#   LLM_MODEL=deepseek-chat
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_API_KEY=sk-...
# Anthropic(Claude)示例:默认开启的隐藏思考会吃掉 max_tokens、截断答案,需关掉:
#   LLM_MODEL=claude-haiku-5-5
#   OPENAI_BASE_URL=https://api.anthropic.com/v1
#   OPENAI_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 厂商专有请求参数(JSON,合并进请求体),不需要就留空
OPENAI_EXTRA_BODY=
# 新 OpenAI 模型(gpt-5 / o 系列)不认 max_tokens,改填 max_completion_tokens;其他服务保持默认
OPENAI_MAX_TOKENS_PARAM=max_tokens
# mock 模式每次调用的模拟耗时(毫秒),便于在页面看清每一步、演示杀 worker
LLM_MOCK_DELAY_MS=1500
# RAG 服务的宿主机端口(8000 被占用时改掉)
RAG_PORT=8000

# 控制台 8080 端口默认只对本机开放;要从局域网 / Tailscale 其他设备访问,改成 0.0.0.0(注意:控制台没有鉴权)
SERVER_BIND=127.0.0.1

# ---- 演示保护。DEMO_ACCESS_CODE 留空 = 关闭(本地开发默认)
# 访问码:除首页外的一切请求都要带 X-Access-Code;通用任务提交和 DLQ 重放在演示模式下禁用
DEMO_ACCESS_CODE=
# 经 Cloudflare Tunnel 访问时设为 true:按 CF-Connecting-IP 识别来源(8080 只绑 127.0.0.1 时才安全)
DEMO_TRUST_PROXY_HEADER=false
